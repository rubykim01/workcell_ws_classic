<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="denso" params="parent">
  <xacro:property name="denso_visual_params" value="${xacro.load_yaml('$(find descriptions)/config/denso_visual_parameters.yaml')}"/>
  <xacro:property name="sec_mesh_files" value="${denso_visual_params['mesh_files']}" scope="parent"/>
  <xacro:property name="force_abs_paths" value="true" scope="parent"/>
  
  <!-- Load trolley positions configuration -->
  <xacro:property name="trolley_positions" value="${xacro.load_yaml('$(find descriptions)/config/trolley_positions.yaml')}"/>
  <xacro:property name="denso_pos" value="${trolley_positions['trolley_positions']['denso']}"/>
  
  <!-- denso trolley link -->
    <link name="denso_trolley_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 -1.57"/>
        <geometry>
          <xacro:get_mesh name="denso_trolley" type="visual"/>
        </geometry>
        <material name="${sec_mesh_files['denso_trolley']['visual']['material']['name']}">
          <color rgba="${sec_mesh_files['denso_trolley']['visual']['material']['color']}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${sec_mesh_files['denso_trolley']['collision']['box']['origin']}" rpy="0 0 0"/>
        <geometry>
          <box size="${sec_mesh_files['denso_trolley']['collision']['box']['size']}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="5.0"/>
        <origin xyz="0 0 -0.43" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- world to trolley joint -->
   <joint name="denso_trolley_joint" type="fixed">
      <parent link="${parent}" />
      <child link="denso_trolley_link" />
      <origin xyz="${denso_pos['x']} ${denso_pos['y']} ${denso_pos['z']}" rpy="${denso_pos['roll']} ${denso_pos['pitch']} ${denso_pos['yaw']}"/>
    </joint>

  <!-- denso slider jig link -->
    <link name="denso_slider_jig_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <xacro:get_mesh name="denso_slider_jig" type="visual"/>
        </geometry>
        <material name="${sec_mesh_files['denso_slider_jig']['visual']['material']['name']}">
          <color rgba="${sec_mesh_files['denso_slider_jig']['visual']['material']['color']}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <xacro:get_mesh name="denso_slider_jig" type="collision"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
      </inertial>
    </link>

    <!-- trolley to denso slider jig joint -->
    <joint name="denso_slider_jig_joint" type="fixed">
      <parent link="denso_trolley_link" />
      <child link="denso_slider_jig_link" />
      <origin xyz="0.025 0.175 0.0" rpy="0 0 0"/>
    </joint>

  <!-- vision feeder link -->
    <link name="vision_feeder_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <xacro:get_mesh name="vision_feeder" type="visual"/>
        </geometry>
        <material name="${sec_mesh_files['vision_feeder']['visual']['material']['name']}">
          <color rgba="${sec_mesh_files['vision_feeder']['visual']['material']['color']}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <xacro:get_mesh name="vision_feeder" type="visual"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
      </inertial>
    </link>

    <!-- trolley to vision feeder joint -->
    <joint name="vision_feeder_joint" type="fixed">
      <parent link="denso_trolley_link" />
      <child link="vision_feeder_link" />
      <origin xyz="0.2 -0.2 0.0" rpy="0 0 0"/>
    </joint>

    <!-- ==================== DENSO ROBOT ARM ==================== -->

    <!-- denso base link -->
    <link name="denso_base_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_base_link.STL" scale="1 1 1"/>
        </geometry>
        <material name="">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_base_link.STL" scale="1 1 1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="30.0"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.15"/>
        <inertia ixx="1.2" ixy="0" ixz="0" iyy="1.2" iyz="0" izz="0.4"/>
      </inertial>
    </link>

    <joint name="denso_axis_joint" type="prismatic">
      <parent link="denso_slider_jig_link"/>
      <child link="denso_base_link"/>
      <origin rpy="0 0 0" xyz="0.01 0 0.084"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.5" upper="0.5" effort="100" velocity="0.5" />
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
    
    <link name="denso_dummy_link">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>

    <!-- slider to dummy link joint -->
    <joint name="denso_dummy_joint" type="fixed">
      <parent link="denso_base_link" />
      <child link="denso_dummy_link" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="denso_J1">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_link1.STL" scale="1 1 1"/>
        </geometry>
        <material name="">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_link1.STL" scale="1 1 1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="10.0"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.25 0.0 0.05"/>
        <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.3" iyz="0" izz="0.08"/>
      </inertial>
    </link>
    <joint name="denso_joint_1" type="revolute">
      <parent link="denso_dummy_link"/>
      <child link="denso_J1"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.4135"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="50" lower="-2.26892802759263" upper="2.26892802759263" velocity="3.08615226990019"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>

    <link name="denso_J2">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_link2.STL" scale="1 1 1"/>
        </geometry>
        <material name="">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_link2.STL" scale="1 1 1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="6.0"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.25 0.0 0.05"/>
        <inertia ixx="0.15" ixy="0" ixz="0" iyy="0.15" iyz="0" izz="0.05"/>
      </inertial>
    </link>
    <joint name="denso_joint_2" type="revolute">
      <parent link="denso_J1"/>
      <child link="denso_J2"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.5 0.0 0.105"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="50" lower="-2.61799387799149" upper="2.61799387799149" velocity="5.41357500737341"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>

    <link name="denso_J3">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_link3.STL" scale="1 1 1"/>
        </geometry>
        <material name="">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_link3.STL" scale="1 1 1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.0"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.05"/>
        <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.02"/>
      </inertial>
    </link>
    <joint name="denso_joint_3" type="prismatic">
      <parent link="denso_J2"/>
      <child link="denso_J3"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.5 0.0 0.0862"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="100" lower="-10" upper="10" velocity="1.9"/>
      <dynamics damping="0.2" friction="0.01"/>
    </joint>

    <link name="denso_J4">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.04"/>
        </geometry>
        <material name="">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="denso_joint_4" type="revolute">
      <parent link="denso_J3"/>
      <child link="denso_J4"/>
      <origin rpy="0.0 0 0" xyz="0.0 0.0 -0.5207"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="10" lower="-6.28318530717959" upper="6.28318530717959" velocity="25.2968981715147"/>
      <dynamics damping="0.05" friction="0.005"/>
    </joint>

    <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
    <link name="denso_flange">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="denso_joint_flange" type="fixed">
      <parent link="denso_J4" />
      <child link="denso_flange" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
    <link name="denso_tool0">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="denso_joint_tool0" type="fixed">
      <!-- Denso toolframe - X+ front, Y+ right, Z+ up -->
      <origin xyz="0 0 0" rpy="3.141592 0 0"/>
      <parent link="denso_flange"/>
      <child link="denso_tool0"/>
    </joint>

    <!-- Screwdriver link attached after J4 -->
    <link name="denso_screwdriver">
      <visual>
        <origin rpy="0 0 -1.57" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_screwdriver.STL" scale="1 1 1"/>
        </geometry>
        <material name="">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 -1.57" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find descriptions)/meshes/denso/denso_screwdriver.STL" scale="1 1 1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.5"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.3"/>
        <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <!-- Joint connecting flange to screwdriver -->
    <joint name="denso_screwdriver_joint" type="fixed">
      <parent link="denso_flange"/>
      <child link="denso_screwdriver"/>
      <origin rpy="0.0 0 0" xyz="0.0 0.0 0.0"/>
    </joint>

  </xacro:macro>
</robot>
